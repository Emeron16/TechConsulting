# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=volvo
POSTGRES_PASSWORD=volvo_local_dev
POSTGRES_DB=volvo_warranty

# --- OpenSearch ---
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9201
OPENSEARCH_DASHBOARDS_PORT=9301
OPENSEARCH_INDEX=volvo_warranty_cases

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
# MLflow 3.x puts the plain filesystem tracking backend into maintenance
# mode by default and raises unless this is set -- confirmed during Phase 4
# both for training (mlflow.start_run()) and for `mlflow ui` itself, which
# runs as its own separate process and does not inherit any in-script
# os.environ.setdefault() call.
MLFLOW_ALLOW_FILE_STORE=true

# --- FastAPI serving layer ---
FASTAPI_HOST=localhost
FASTAPI_PORT=8100
FASTAPI_BASE_URL=http://localhost:8100

# --- Airflow ---
AIRFLOW_BASE_URL=http://localhost:8180
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DAG_ID=volvo_case_pipeline

# --- PySpark / Java ---
# PySpark's local[*] mode still needs a JVM even without a cluster, and its
# worker processes must match the driver's Python minor version exactly --
# without PYSPARK_PYTHON/PYSPARK_DRIVER_PYTHON pinned to this venv, Spark
# picks up whatever `python3` resolves to on PATH (e.g. a system 3.14),
# which crashes every task with PYTHON_VERSION_MISMATCH. Confirmed during
# Phase 0 verification -- this is not a hypothetical failure mode.
JAVA_HOME=/opt/homebrew/opt/openjdk@17
PYSPARK_PYTHON=./volvo-demo/.venv/bin/python
PYSPARK_DRIVER_PYTHON=./volvo-demo/.venv/bin/python
